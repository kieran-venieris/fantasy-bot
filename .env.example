# Copy to .env and fill in. .env is gitignored — never commit real values.

# ESPN auth cookies. Get them from a logged-in browser:
#   DevTools (F12) → Application → Cookies → https://fantasy.espn.com
ESPN_S2=paste_your_espn_s2_cookie_here
SWID={PASTE-YOUR-SWID-COOKIE-INCLUDING-CURLY-BRACES}

# Your league and team. Both are in the league URL:
#   https://fantasy.espn.com/football/team?leagueId=<LEAGUE_ID>&teamId=<TEAM_ID>
LEAGUE_ID=123456789
TEAM_ID=1

# Season. Optional, defaults to 2026.
#YEAR=2026

# Only needed for unattended launchd/cron runs of run.sh, so the CLI can
# authenticate without an interactive login. Omit to use the local keychain.
#CLAUDE_CODE_OAUTH_TOKEN=
